# =====================================================================================
# AI Voice Studio backend configuration
#
#   1) Copy this file to  backend/.env      (command from the project root:  cp .env.example backend/.env)
#   2) Edit backend/.env and fill in the values below.
#   3) Never commit backend/.env, never paste real keys into chat, screenshots or the Android app.
#
# On a hosting platform (Render, Railway, Fly.io, Docker, ...) set the SAME variable names in the
# platform's "Environment variables" screen instead of using a file.
# Real environment variables always override values in backend/.env.
# =====================================================================================

# ---- required ------------------------------------------------------------------------
# A long random secret used to sign login tokens (32+ characters). Generate one with:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-of-32+chars

# ---- TTS providers: fill in the key of every provider you want to use ----------------
# ElevenLabs  -> https://elevenlabs.io  (account settings -> API Keys)
ELEVENLABS_API_KEY= sk_a4b52ad3227f1d32b3011dc46d53c9257a3b8ac4c4b4a7e6
# OpenAI      -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Cloud Text-to-Speech -> API key from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_TTS_API_KEY=

# Which provider the server uses when the app does not choose one: elevenlabs | openai | google
# Leave empty to use the first provider that has a key (order: elevenlabs, openai, google).
TTS_PROVIDER= elevenlabs

# ---- server ---------------------------------------------------------------------------
PORT=8080
# DB_PATH=./data/app.db
# AUDIO_DIR=./data/audio
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For
# TRUST_PROXY=false
# Public HTTPS address of this backend (used in verification-email links)
# PUBLIC_BASE_URL=https://your-backend.example.com

# ---- usage limits (your app credits, separate from your provider billing) -------------
MAX_TEXT_CHARS=5000
FREE_MONTHLY_CHARS=10000
# Extra plans, e.g. {"pro":500000}. Assign plans to users from the admin dashboard (/admin).
# PLAN_LIMITS_JSON={}

# ---- email (verification + password reset) --------------------------------------------
# The backend POSTs {to, subject, text} as JSON to this HTTPS webhook (your own mail function/service).
# Without it no email is sent and the app says so.
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_SECRET=
# Require verified email before sign-in (needs the mail webhook)
REQUIRE_EMAIL_VERIFICATION=false

# ---- advanced / rate limits (per minute) ------------------------------------------------
# PROVIDER_TIMEOUT_MS=90000
# AUTH_RATE_LIMIT_PER_MIN=10
# TTS_RATE_LIMIT_PER_MIN=20
# GLOBAL_RATE_LIMIT_PER_MIN=240
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# OPENAI_BASE_URL=https://api.openai.com
# GOOGLE_TTS_BASE_URL=https://texttospeech.googleapis.com
