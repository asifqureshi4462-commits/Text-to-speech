# AI Voice Studio backend configuration (copy to backend/.env or set as real environment variables).
# NEVER commit a real .env file. Values below are safe placeholders only.

# --- required ---
# At least 32 random characters:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-of-32+chars

# --- voice provider (required for real speech generation) ---
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# PROVIDER_TIMEOUT_MS=90000

# --- server ---
PORT=8080
# DB_PATH=./data/app.db
# AUDIO_DIR=./data/audio
# Set true only when running behind a trusted reverse proxy that sets X-Forwarded-For
# TRUST_PROXY=false
# Public HTTPS address of this backend (used in verification-email links)
# PUBLIC_BASE_URL=https://your-backend.example.com

# --- usage limits (your app credits, separate from your ElevenLabs billing) ---
MAX_TEXT_CHARS=5000
FREE_MONTHLY_CHARS=10000
# Extra plans, e.g. {"pro":500000}. Assign plans to users from the admin dashboard.
# PLAN_LIMITS_JSON={}

# --- email (verification + password reset) ---
# The backend POSTs {to, subject, text} as JSON to this HTTPS webhook (your own mail function/service).
# Without it no email is sent and the app says so.
# MAIL_WEBHOOK_URL=
# MAIL_WEBHOOK_SECRET=
# Require verified email before sign-in (needs the mail webhook)
REQUIRE_EMAIL_VERIFICATION=false

# --- rate limits (per minute) ---
# AUTH_RATE_LIMIT_PER_MIN=10
# TTS_RATE_LIMIT_PER_MIN=20
# GLOBAL_RATE_LIMIT_PER_MIN=240
