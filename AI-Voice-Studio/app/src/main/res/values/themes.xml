<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIVoiceStudio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorSecondary">@color/app_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorError">@color/app_error</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/button_radius</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AIVoiceStudio</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/app_text_secondary</item>
    </style>
    <style name="Text.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/app_text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
